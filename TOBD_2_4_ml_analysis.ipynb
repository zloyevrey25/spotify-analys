   "source": [
    "# Приведение типов\n",
    "df[\"streams\"] = pd.to_numeric(df[\"streams\"], errors=\"coerce\")\n",
    "df = df.dropna(subset=[\"streams\"]).copy()\n",
    "\n",
    "for col in [\"week\", \"release_date\"]:\n",
    "    if col in df.columns:\n",
    "        df[col] = pd.to_datetime(df[col], errors=\"coerce\")\n",
    "\n",
    "# Простые производные признаки\n",
    "df[\"log_streams\"] = np.log1p(df[\"streams\"])\n",
    "\n",
    "if \"artist_followers\" in df.columns:\n",
    "    df[\"artist_followers\"] = pd.to_numeric(\n",
    "        df[\"artist_followers\"], errors=\"coerce\"\n",
    "    )\n",
    "    df[\"log_artist_followers\"] = np.log1p(df[\"artist_followers\"])\n",
    "\n",
    "if {\"week\", \"release_date\"}.issubset(df.columns):\n",
    "    df[\"release_age_days\"] = (\n",
    "        df[\"week\"] - df[\"release_date\"]\n",
    "    ).dt.days.clip(lower=0)\n",
    "\n",
    "for col in [\"explicit\", \"collab\"]:\n",
    "    if col in df.columns:\n",
    "        df[col] = (\n",
    "            df[col].astype(str).str.lower()\n",
    "            .map({\"true\": 1, \"false\": 0, \"1\": 1, \"0\": 0})\n",
    "        )\n",
    "\n",
    "popular_threshold = df[\"streams\"].quantile(0.75)\n",
    "df[\"popular\"] = (df[\"streams\"] >= popular_threshold).astype(int)\n",
    "\n",
    "print(f\"Порог верхнего квартиля streams: {popular_threshold:,.0f}\")\n",
    "print(\"Доли классов:\")\n",
    "display(df[\"popular\"].value_counts(normalize=True).rename(\"share\").to_frame())\n"
   ]
