    "from pathlib import Path\n",
    "import warnings\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from IPython.display import display, Markdown\n",
    "from sklearn.model_selection import GroupShuffleSplit\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.dummy import DummyClassifier\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, precision_score, recall_score, f1_score,\n",
    "    roc_auc_score, confusion_matrix, silhouette_score\n",
    ")\n",
    "from sklearn.cluster import KMeans\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "pd.set_option(\"display.max_columns\", 100)\n",
    "\n",
    "PROCESSED_CANDIDATES = [\n",
    "    Path(\"data/processed/music_merged.csv\"),\n",
    "    Path(\"../data/processed/music_merged.csv\"),\n",
    "]\n",
    "\n",
    "SPOTIFY_URL = (\n",
    "    \"https://raw.githubusercontent.com/younver/\"\n",
    "    \"spotify-top-200-dataset/main/spotify-top-200-dataset.csv\"\n",
    ")\n",
    "\n",
    "processed_path = next(\n",
    "    (p for p in PROCESSED_CANDIDATES if p.exists()),\n",
    "    None\n",
    ")\n",
    "\n",
    "if processed_path is not None:\n",
    "    df = pd.read_csv(processed_path, low_memory=False)\n",
    "    source_mode = \"merged\"\n",
    "    print(\"Загружен объединенный набор:\", processed_path)\n",
    "else:\n",
    "    print(\n",
    "        \"Файл 2.3 не найден. Загружается резервный Spotify-набор.\\n\"\n",
    "        \"Для проверки текстовой части запустите 2.3 в той же рабочей папке.\"\n",
    "    )\n",
    "    raw = pd.read_csv(SPOTIFY_URL, sep=\";\", low_memory=False)\n",
    "\n",
    "    if \"pivot\" in raw.columns:\n",
    "        pivot_num = pd.to_numeric(raw[\"pivot\"], errors=\"coerce\").fillna(0)\n",
    "        raw = raw[pivot_num == 0].copy()\n",
    "\n",
    "    raw[\"week\"] = pd.to_datetime(raw[\"week\"], errors=\"coerce\")\n",
    "    raw[\"release_date\"] = pd.to_datetime(raw[\"release_date\"], errors=\"coerce\")\n",
    "    raw = raw.dropna(subset=[\"track_name\", \"artist_name\", \"week\", \"streams\"])\n",
    "\n",
    "    if {\"track_id\", \"week\"}.issubset(raw.columns):\n",
    "        raw = raw.drop_duplicates([\"track_id\", \"week\"], keep=\"first\")\n",
    "\n",
    "    df = raw.copy()\n",
    "    source_mode = \"spotify_only\"\n",
    "\n",
    "print(\"Режим:\", source_mode)\n",
    "print(\"Размер:\", df.shape)\n",
    "display(df.head())\n"
   ]
